{
  "name": "lookover-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "biome check . && pnpm -r typecheck && pnpm -r test",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @jayslifecode/lookover-cli test:e2e",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5",
    "@types/node": "^24",
    "typescript": "^5.9",
    "vitest": "^5.0"
  }
}
