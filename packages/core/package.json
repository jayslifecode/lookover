{
  "name": "@jayslifecode/lookover-core",
  "version": "0.0.0",
  "description": "Lookover core: the review engine behind the lookover CLI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
