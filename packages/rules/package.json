{
  "name": "@jayslifecode/lookover-rules",
  "version": "0.0.0",
  "description": "The Lookover rules catalogue: every heuristic a finding can name.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "catalogue",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalogue/*.json": "./catalogue/*.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "docs": "node --experimental-strip-types scripts/generate-docs.ts"
  },
  "dependencies": {
    "zod": "^4.6"
  }
}
